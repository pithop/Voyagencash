# ── ACCÈS PARTENAIRES (fondatrice 28/08 : « je te donnerai les API de chaque
#    partenaire, tu intègres tout ») — remplir puis relancer : chaque adaptateur
#    bascule de MOCK à RÉEL tout seul dès que ses variables existent. ──

# Odoo — facturation (server/services/facturation/odoo.js)
ODOO_URL=            # ex. https://ajek.odoo.com
ODOO_DB=             # nom de la base
ODOO_USER=           # utilisateur API (email)
ODOO_API_KEY=        # clé API (Paramètres → Sécurité → Clés API)

# Duffel — vols (server/services/voyage)
DUFFEL_TOKEN=        # Access token (test puis live)

# Nuitée / liteAPI — hôtels (server/services/voyage)
LITEAPI_KEY=         # clé sandbox puis prod

# Brevo — SMS & emails transactionnels
BREVO_API_KEY=

# Paymentwall — le paiement EN LIGNE (Neosurf · iDEAL hors France) — server/services/encaissement
#   page de paiement hébergée + pingback serveur à serveur (répondre « OK », sinon renvoi toutes les 30 min)
PAYMENTWALL_PROJECT_KEY=   # clé publique du projet (page hébergée)
PAYMENTWALL_SECRET_KEY=    # clé secrète : signature des pingbacks (jamais côté client)
PAYMENTWALL_WIDGET=p1_1    # le widget du projet (page hébergée)
PAYMENTWALL_TEST=1         # 1 = « Evaluation Mode » du projet : pingbacks is_test=1 — à retirer à l'activation
PAYMENTWALL_SIGN_VERSION=3 # 3 = SHA-256 (2 = MD5) — la version 1 est dépréciée
PSP_PAGE_URL=              # SANS clés Paymentwall : URL de la page SIMULÉE (défaut : https://checkout.payencash.fr/pw) — ecrans/24-paymentwall
PAYS_OUVERT=FR             # le pays d'ouverture décide des moyens proposés (iDEAL = NL seulement)
PAYMENTWALL_API_BASE=      # optionnel — défaut https://api.paymentwall.com (Delivery Confirmation, tickets de remboursement, statut)
PAYMENTWALL_WIDGET_BASE=   # optionnel — défaut https://api.paymentwall.com/api/subscription (la page hébergée)
PAYMENTWALL_PINGBACK_IPS=  # optionnel — défaut 216.127.71.0/24 : les plages d'origine des pingbacks, séparées par des virgules

# Bon PayEnCash (18/09) — server/services/bons : le code d'un bon n'est JAMAIS stocké en clair, seule son empreinte
#   (SHA-256, salée par ce poivre serveur) l'est. À poser AVANT la première émission et à ne plus changer : sans lui,
#   les bons déjà émis ne se retrouveraient plus. Jamais côté client.
BONS_HASH_PEPPER=

# Stripe (21/09 — décision fondatrice « je vais retenir Stripe Connect », « supprime Stancer ») — server/lib/stripe.js
#   UN SEUL prestataire pour les deux lignes : il DÉBITE LA CARTE DU POINT DE VENTE à chaque bon vendu (Mode : sur notre
#   compte ; Solution : directement sur le compte connecté de la MARQUE, notre commission prélevée à la source), et il
#   PORTE les comptes des marques (Connect, inscription hébergée, KYB). Tarif standard : 1,5 % + 0,25 € par carte EEE.
#   ⚠ LE NUMÉRO DE CARTE N'ENTRE JAMAIS CÔTÉ SERVEUR : il se saisit dans le composant Stripe du navigateur du gérant
#   (SetupIntent, authentification forte une fois) ; nous ne recevons que l'empreinte `pm_…`.
#   DEUX JEUX DE CLÉS, un par mode : le mode courant est le réglage `stripe.mode` (Configuration manager), sinon
#   STRIPE_MODE. Une clé qui n'est pas de son mode (sk_test_ dans la case LIVE…) rend le module inactif et le dit.
#   Tant que la clé du mode courant est absente, tout est SIMULÉ et le dit — aucun appel réseau n'est fait.
STRIPE_MODE=test                 # test | live — le RÉGLAGE settings 'stripe.mode' a priorité (bascule depuis le manager)
STRIPE_SECRET_KEY_TEST=          # sk_test_… — JAMAIS dans le dépôt, jamais côté client
STRIPE_PUBLISHABLE_KEY_TEST=     # pk_test_… — la seule qui part au navigateur (composant de carte)
STRIPE_WEBHOOK_SECRET_TEST=      # whsec_… du canal « notre compte » (rendu UNE fois par POST /solution/stripe/destinations)
STRIPE_CONNECT_WEBHOOK_SECRET_TEST=   # whsec_… du canal « comptes connectés »
STRIPE_CONNECT_CLIENT_ID_TEST=   # ca_… (réglages Connect) — pour qu'une marque qui a DÉJÀ Stripe relie son compte (OAuth)
STRIPE_SECRET_KEY_LIVE=          # sk_live_… — collée par la fondatrice, uniquement ici
STRIPE_PUBLISHABLE_KEY_LIVE=     # pk_live_…
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_CONNECT_WEBHOOK_SECRET_LIVE=
STRIPE_CONNECT_CLIENT_ID_LIVE=
STRIPE_API_BASE=                 # optionnel — défaut https://api.stripe.com
STRIPE_OAUTH_BASE=               # optionnel — défaut https://connect.stripe.com
STRIPE_API_VERSION=              # optionnel — vide = la version d'API du compte
STRIPE_DEVISE=eur                # optionnel — la devise des prélèvements
PUBLIC_API_BASE=                 # l'adresse publique de l'API (ex. https://api.payencash.fr) : les canaux de notifications Stripe y pointent
PUBLIC_APP_BASE=                 # l'adresse publique des écrans (ex. https://app.payencash.fr/ui) : retours d'inscription des marques

# Prestataire PVID — vérification d'identité renforcée
PVID_API_KEY=
