{
  "version": 2,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/vols", "destination": "/index.html" },
    { "source": "/aller-simple", "destination": "/index.html" },
    { "source": "/mes-billets", "destination": "/index.html" },
    { "source": "/ou-payer", "destination": "/index.html" },
    { "source": "/aide", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
