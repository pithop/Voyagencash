# Copiez ce fichier vers .env pour le développement local.
# Les valeurs Vercel sont lues directement dans les variables du projet.
# Laissez DUFFEL_API_TOKEN vide pour la démonstration complète.
PORT=4173
DUFFEL_API_TOKEN=
LIVE_CHECKOUT_ENABLED=false

# Requis pour la réservation réelle, en complément du jeton Duffel.
DATABASE_URL=
PAYENCASH_ADAPTER_URL=
PAYENCASH_API_KEY=
PAYENCASH_WEBHOOK_SECRET=
VOUCHER_SIGNING_SECRET=
CRON_SECRET=

# Optionnel : Paiement par Carte Bancaire et Apple Pay / Google Pay via Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
